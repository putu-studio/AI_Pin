# Copy this file to .env and set your own token.
# The pin sends the same value in its X-Device-Token header (RELAY_TOKEN in secrets.h).
DEVICE_TOKEN=change-me-to-a-long-random-string

# Optional second language for speech-to-text (see "Supporting other languages" in README.md).
# A Whisper language code such as es, hi or ar. Leave empty for English only.
SECOND_LANGUAGE=
# A Whisper size (small, medium, large-v3) or a Hugging Face model ID for that language.
SECOND_LANGUAGE_MODEL=medium
